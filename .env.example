APP_NAME="GCA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Pin the cache key prefix so it never derives from APP_NAME (renaming the app
# would otherwise reset all rate-limit counters and cached data).
CACHE_PREFIX=gca_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe / Laravel Cashier (billing)
# Get keys at https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=
STRIPE_SECRET=
# Webhook signing secret (stripe listen / dashboard endpoint)
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe. Run `php artisan stripe:sync-products --write-env` to
# create the products/prices and fill these in automatically (see docs/STRIPE_SETUP.md).
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
CASHIER_CURRENCY=usd
# Optional (have defaults): Stripe product naming + tax code used by stripe:sync-products
# STRIPE_PRODUCT_PREFIX=GCA
# STRIPE_TAX_CODE=txcd_10103001

# Explorer search — Laravel Scout + Algolia (build-ready).
# Leave SCOUT_DRIVER=null until Algolia keys exist, then set it to "algolia".
# See docs/ALGOLIA_SETUP.md.
SCOUT_DRIVER=null
SCOUT_PREFIX=gca_
ALGOLIA_APP_ID=
ALGOLIA_SECRET=
ALGOLIA_SEARCH_KEY=

# Google Maps — explorer map (Part 2)
GOOGLE_MAPS_API_KEY=

# Anthropic — scorecard scanning in the course editor. Server-side key, never
# sent to the browser. Without it the scan page reports a configuration error
# instead of failing silently on every upload. Also needs the `gd` PHP
# extension for image resizing. See docs/SCORECARD_SCANNING.md.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
