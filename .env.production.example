# Production environment template for Hostinger (Premium Web Hosting / shared).
# Copy to `.env` on the server and fill in the blanks. NEVER commit the real .env.
# See docs/DEPLOY_HOSTINGER.md for the full runbook.

APP_NAME="GCA"
APP_ENV=production
# Leave empty, then run `php artisan key:generate` on the server (once).
APP_KEY=
APP_DEBUG=false
# Staging first (e.g. https://gca.your-existing-domain), then the real domain at cutover.
APP_URL=https://CHANGE_ME

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Quieter logs in production; rotate daily so storage/logs doesn't grow unbounded.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL (Hostinger). Host is normally "localhost" on shared hosting.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Sessions live in the DB. Secure cookie = HTTPS only (issue SSL before go-live).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=gca_cache

# --- Mail ---------------------------------------------------------------------
# Password resets, verification, and Stripe receipts need real SMTP in production.
# Default to `log` (safe no-op) until SMTP is configured. Hostinger email example:
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=you@your-domain
# MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="hello@your-domain"
MAIL_FROM_NAME="${APP_NAME}"

# Build-time (used by Vite when assets are built).
VITE_APP_NAME="${APP_NAME}"

# --- Optional integrations (app degrades gracefully when unset) ---------------

# Stripe / Laravel Cashier (billing). See docs/STRIPE_SETUP.md.
# Use LIVE keys in production; add the webhook at https://<domain>/stripe/webhook.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
CASHIER_CURRENCY=usd

# Explorer search — Laravel Scout + Algolia. See docs/ALGOLIA_SETUP.md.
# Leave SCOUT_DRIVER=null until Algolia keys exist, then set it to "algolia".
SCOUT_DRIVER=null
SCOUT_PREFIX=gca_
ALGOLIA_APP_ID=
ALGOLIA_SECRET=
ALGOLIA_SEARCH_KEY=

# Google Maps — explorer map.
GOOGLE_MAPS_API_KEY=

# Anthropic — scorecard scanning in the course editor. Server-side key, never
# sent to the browser. Without it the scan page reports a configuration error
# instead of failing silently on every upload. Also needs the `gd` PHP
# extension for image resizing. See docs/SCORECARD_SCANNING.md.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
